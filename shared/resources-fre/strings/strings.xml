    <string id="LvlMid">Moyen</string>
    <string id="LvlHigh">Eleve</string>
    <string id="LvlMax">Maxi</string>
    <string id="ModeOff">Eteint</string>

    <!-- Modes abreges, pour les champs de donnees etroits -->
    <string id="ShortDipLow">Cr. faible</string>
    <string id="ShortDipMid">Cr. moyen</string>
    <string id="ShortDipHigh">Cr. eleve</string>
    <string id="ShortMainLow">Rt. faible</string>
    <string id="ShortMainMid">Rt. moyen</string>
    <string id="ShortMainHigh">Rt. eleve</string>
    <string id="ShortFlashDay">Flash jour</string>
    <string id="ShortFlashNight">Flash nuit</string>

    <!-- Modes en toutes lettres, vocabulaire de l'app iGPSPORT -->
    <string id="ModeDipLow">Croisement faible</string>
    <string id="ModeDipMid">Croisement moyen</string>
    <string id="ModeDipHigh">Croisement eleve</string>
    <string id="ModeMainLow">Route faible</string>
    <string id="ModeMainMid">Route moyen</string>
    <string id="ModeMainHigh">Route eleve</string>
    <string id="ModeSteadyLow">Fixe faible</string>
    <string id="ModeSteadyMid">Fixe moyen</string>
    <string id="ModeSteadyHigh">Fixe eleve</string>
