<!--
  Libelles partages par le champ de donnees et l'application compagnon (francais).

  Genere a la main, mais garde en phase avec resources/strings/strings.xml : les deux fichiers
  doivent declarer exactement les memes identifiants. Un identifiant present
  d'un seul cote passerait la compilation et manquerait a l'execution sur les
  appareils de l'autre langue.
-->
<strings>

    <!-- Type de lampe (blt_light_self.lightType) -->
    <string id="TypeTail">Arrière</string>
    <string id="TypeFront">Avant</string>
    <string id="TypeHead">Frontale</string>
    <string id="TypeLeft">Gauche</string>
    <string id="TypeRight">Droite</string>

    <!-- Categories : libelle complet puis repli pour tuile etroite -->
    <string id="CatLowBeam">Croisement</string>
    <string id="CatHighBeam">Route</string>
    <string id="CatSteady">Fixe</string>
    <string id="CatFlash">Flash</string>
    <string id="CatCustom">Perso</string>
    <string id="CatOff">Éteint</string>
    <string id="CatLowBeamShort">Crois.</string>
    <string id="CatHighBeamShort">Route</string>
    <string id="CatSteadyShort">Fixe</string>
    <string id="CatFlashShort">Flash</string>
    <string id="CatCustomShort">Perso</string>
    <string id="CatOffShort">Off</string>

    <!-- Crans d'intensite, tels qu'ecrits sur les tuiles de niveau -->
    <string id="LvlLow">Faible</string>
    <string id="LvlMid">Moyen</string>
    <string id="LvlHigh">Élevé</string>
    <string id="LvlMax">Maxi</string>
    <string id="ModeOff">Off</string>

    <!-- Modes abreges, pour les champs de donnees etroits -->
    <string id="ShortDipLow">Croisement 1</string>
    <string id="ShortDipMid">Croisement 2</string>
    <string id="ShortDipHigh">Croisement 3</string>
    <string id="ShortMainLow">Route 1</string>
    <string id="ShortMainMid">Route 2</string>
    <string id="ShortMainHigh">Route 3</string>
    <string id="ShortFlashDay">Diurne</string>
    <string id="ShortFlashNight">Nuit</string>

    <!-- Modes en toutes lettres, vocabulaire de l'app iGPSPORT -->
    <string id="ModeDipLow">Croisement 1</string>
    <string id="ModeDipMid">Croisement 2</string>
    <string id="ModeDipHigh">Croisement 3</string>
    <string id="ModeMainLow">Route 1</string>
    <string id="ModeMainMid">Route 2</string>
    <string id="ModeMainHigh">Route 3</string>
    <string id="ModeSteadyLow">Fixe faible</string>
    <string id="ModeSteadyMid">Fixe moyen</string>
    <string id="ModeSteadyHigh">Fixe élevé</string>
    <string id="ModeFlashDay">Flash diurne</string>
    <string id="ModeFlashNight">Flash nocturne</string>
    <string id="ModeGradient">Dégradé</string>
    <string id="ModeMaximum">Maximum</string>
    <string id="ModeSos">SOS</string>

    <!-- Effets lumineux, listes dans la categorie Flash -->
    <string id="ModeComet">Comète</string>
    <string id="ModeWaterfall">Cascade</string>
    <string id="ModePinwheel">Moulinet</string>
    <string id="ModeRotation">Rotatif</string>
    <string id="ModeLeftTurn">Clignotant gauche</string>
    <string id="ModeRightTurn">Clignotant droit</string>

    <!-- Prefixes des modes numerotes : suivis du numero -->
    <string id="PrefixCustom">Perso </string>
    <string id="PrefixCustomLong">Personnalisé </string>
    <string id="PrefixSpecial">Spécial </string>
    <string id="PrefixMode">Mode </string>

    <!-- Bandeau de la page de pilotage -->
    <string id="LightGeneric">Lampe</string>
    <string id="BadgeAuto">AUTO</string>
    <!-- « MANUEL » en entier : « MANU » n'est pas un mot, la ou « MAN » est une
         abreviation recue en anglais. La pastille se dimensionne sur le plus
         long des deux libelles, elle s'adapte donc d'elle-meme. -->
    <string id="BadgeManual">MANUEL</string>

    <!-- Etapes de la liaison BLE.
         Deux etapes seulement, et des mots de tous les jours : « Abonnement »
         ou « Liaison » ne disaient rien a personne, et chaque etape ayant une
         longueur differente, le texte changeait de taille a chaque changement
         d'etat. La forme courte sert au bandeau, la forme longue a l'ecran
         d'attente. -->
    <string id="StScanning">Recherche</string>
    <string id="StConnecting">Connexion</string>
    <string id="StReady">OK</string>
    <string id="StUnsupported">Sans BLE</string>

    <!-- Ecran d'attente. Deux niveaux, et c'est tout : un mot pour l'etape, une
         ligne pour ce qu'il veut dire. Les mots d'etape font tous la meme
         longueur a une lettre pres, ce qui n'est pas un hasard — la police est
         mesuree sur le plus long, donc ils s'affichent tous a la meme taille. -->
    <!-- Au repos : la recherche ne demarre pas seule, la page propose
         un bouton. Voir le reglage « chercher au demarrage ». -->
    <string id="MsgIdle">Détecter</string>
    <string id="MsgIdleHint">toucher pour lancer la recherche</string>
    <string id="MsgIdleHintTimer">part avec le chrono</string>
    <string id="MsgIdleHintLap">appui Lap pour chercher</string>
    <string id="MsgSearching">Recherche</string>
    <string id="MsgSearchingHint">de votre lampe</string>
    <string id="MsgConnecting">Connexion</string>
    <string id="MsgConnectingHint">lampe trouvée</string>
    <string id="MsgNoBle">Bluetooth</string>
    <string id="MsgNoBleHint">indisponible</string>

    <!-- Rappel affiche cinq secondes apres une extinction demandee depuis le
         compteur. Eteindre par l'application coupe le faisceau, pas la radio :
         la lampe reste connectee et continue de se decharger. Le seul geste qui
         l'arrete vraiment est l'appui long sur son bouton. Voir
         docs/protocole-vs1800s.md. -->
    <string id="NoticeOff">Pensez à l'éteindre au bouton</string>

    <!-- Identification : la lampe clignote pour se designer elle-meme -->
    <string id="MsgIdentify">Celle-ci ?</string>
    <string id="MsgIdentifySoon">votre lampe va clignoter</string>
    <string id="MsgIdentifyHint">votre lampe clignote</string>
    <!-- Precede du nombre : « 2 lampes a proximite » -->
    <string id="MsgNearby"> lampes à proximité</string>
    <string id="MsgOtherLight">Changer de lampe</string>
    <string id="MsgOtherLightHint">Chercher à nouveau</string>

    <!-- Echecs de liaison, affiches a la place de l'etat -->
    <string id="ErrScanRefused">scan refusé</string>
    <string id="ErrBleUnavailable">BLE non disponible</string>
    <string id="ErrProfilesRefused">profils refusés</string>
    <string id="ErrWriteRefused">écriture refusée</string>
    <string id="ErrProfileRegister">enregistrement du profil en échec</string>
    <string id="ErrServiceMissing">service absent</string>
    <string id="ErrCharsMissing">caractéristiques absentes</string>
    <string id="ErrCccdMissing">CCCD absent</string>
    <string id="ErrSubscribeRefused">abonnement refusé</string>
    <string id="ErrWriteFailed">écriture en échec</string>
    <string id="ErrBatterySubscribe">abonnement batterie refusé</string>

    <!-- Champ de donnees etroit : etat de l'ajustement automatique -->
    <string id="DfAuto">LAMPE - AUTO</string>
    <string id="DfManual">LAMPE - MANUEL</string>

    <!-- Unite d'autonomie -->
    <string id="UnitMin">min</string>
</strings>
