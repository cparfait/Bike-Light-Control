    <string id="ModeDipLow">Dipped 1</string>
    <string id="ModeDipMid">Dipped 2</string>
    <string id="ModeDipHigh">Dipped 3</string>
    <string id="ModeMainLow">Main 1</string>
    <string id="ModeMainMid">Main 2</string>
    <string id="ModeMainHigh">Main 3</string>
    <string id="ModeSteadyLow">Steady low</string>
    <string id="ModeSteadyMid">Steady medium</string>
    <string id="ModeSteadyHigh">Steady high</string>
    <string id="ModeFlashDay">Daytime flash</string>
    <string id="ModeFlashNight">Night flash</string>
    <string id="ModeGradient">Gradient</string>
    <string id="ModeMaximum">Maximum</string>
    <string id="ModeSos">SOS</string>

    <!-- Effets lumineux, listes dans la categorie Flash -->
    <string id="ModeComet">Comet</string>
    <string id="ModeWaterfall">Waterfall</string>
    <string id="ModePinwheel">Pinwheel</string>
    <string id="ModeRotation">Rotating</string>
    <string id="ModeLeftTurn">Left turn</string>
    <string id="ModeRightTurn">Right turn</string>

    <!-- Prefixes des modes numerotes : suivis du numero -->
    <string id="PrefixCustom">Custom </string>
    <string id="PrefixCustomLong">Custom </string>
    <string id="PrefixSpecial">Special </string>
    <string id="PrefixMode">Mode </string>

    <!-- Bandeau de la page de pilotage -->
    <string id="LightGeneric">Light</string>
    <string id="BadgeAuto">AUTO</string>
    <string id="BadgeManual">MANUAL</string>

    <!-- Etapes de la liaison BLE.
         Deux etapes seulement, et des mots de tous les jours : « Abonnement »
         ou « Liaison » ne disaient rien a personne, et chaque etape ayant une
         longueur differente, le texte changeait de taille a chaque changement
         d'etat. La forme courte sert au bandeau, la forme longue a l'ecran
         d'attente. -->
    <string id="StScanning">Searching</string>
    <string id="StConnecting">Connecting</string>
    <string id="StReady">OK</string>
    <string id="StUnsupported">No BLE</string>

    <!-- Ecran d'attente. Deux niveaux, et c'est tout : un mot pour l'etape, une
         ligne pour ce qu'il veut dire. Les mots d'etape font tous la meme
         longueur a une lettre pres, ce qui n'est pas un hasard — la police est
         mesuree sur le plus long, donc ils s'affichent tous a la meme taille. -->
    <!-- Au repos : la recherche ne demarre pas seule, la page propose
         un bouton. Voir le reglage « chercher au demarrage ». -->
    <string id="MsgIdle">Detect</string>
    <!-- Trois mots, pas une phrase. Cette chaine sert de **reference de
         mesure** a toute la ligne de precision de l'ecran d'attente : la police
         est choisie sur la plus longue, jamais sur celle du moment. Une
         consigne bavarde rapetissait donc « lampe trouvee » et « 3 lampes a
         proximite » avec elle. -->
    <string id="MsgIdleHint">tap to search</string>
    <!-- Sur un Edge a boutons, la case ne recoit aucune tape : c'est le
         chrono qui lance la recherche, et c'est ce qu'il faut ecrire. -->
    <string id="MsgIdleHintTimer">starts with the timer</string>
    <!-- Champ de donnees au repos : le geste qui lance la recherche.
         C'est **Lap** et non la tape, sur les treize modeles — la tape n'atteint
         le champ que sur les Edge sans barre de controle. Cette chaine sert de
         valeur principale dans une petite case, ou elle remplace le mot d'etape :
         la garder courte n'est pas une coquetterie, c'est ce qui la rend
         lisible. Voir LampView._idleHint(). -->
    <string id="MsgIdleHintLap">Lap to search</string>
    <string id="MsgSearching">Searching</string>
    <string id="MsgSearchingHint">for your light</string>
    <string id="MsgConnecting">Connecting</string>
    <string id="MsgConnectingHint">light found</string>
    <string id="MsgNoBle">Bluetooth</string>
    <string id="MsgNoBleHint">unavailable</string>

    <!-- Rappel affiche cinq secondes apres une extinction demandee depuis le
         compteur. Eteindre par l'application coupe le faisceau, pas la radio :
         la lampe reste connectee et continue de se decharger. Le seul geste qui
         l'arrete vraiment est l'appui long sur son bouton. Voir
         docs/protocole-vs1800s.md. -->
    <string id="NoticeOff">Also switch it off at the light</string>

    <!-- Identification : la lampe clignote pour se designer elle-meme -->
    <string id="MsgIdentify">This one?</string>
    <string id="MsgIdentifySoon">your light will blink</string>
    <string id="MsgIdentifyHint">your light is blinking</string>
    <!-- Precede du nombre : « 2 lampes a proximite » -->
    <string id="MsgNearby"> lights nearby</string>
    <string id="MsgOtherLight">Another light</string>
    <string id="MsgOtherLightHint">Search again</string>

    <!-- Echecs de liaison, affiches a la place de l'etat -->
    <string id="ErrScanRefused">scan refused</string>
    <string id="ErrBleUnavailable">BLE unavailable</string>
    <string id="ErrProfilesRefused">profiles refused</string>
    <string id="ErrWriteRefused">write refused</string>
    <string id="ErrProfileRegister">profile setup failed</string>
    <string id="ErrServiceMissing">service missing</string>
    <string id="ErrCharsMissing">characteristics missing</string>
    <string id="ErrCccdMissing">CCCD missing</string>
    <string id="ErrSubscribeRefused">subscribe refused</string>
    <string id="ErrWriteFailed">write failed</string>
    <string id="ErrBatterySubscribe">battery subscribe refused</string>

    <!-- Champ de donnees etroit : etat de l'ajustement automatique -->
    <string id="DfAuto">LIGHT - AUTO</string>
    <string id="DfManual">LIGHT - MANUAL</string>

    <!-- Unite d'autonomie -->
    <string id="UnitMin">min</string>
</strings>
