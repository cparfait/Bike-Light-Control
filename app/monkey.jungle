project.manifest = manifest.xml

# Deux jeux de code hors des binaires de diffusion :
#
#   debug   surcouche de diagnostic de LampPanel. Pour la lire sur l'appareil,
#           remplacer `debug` par `nodebug` ici, et mettre `panel.debug = true`
#           dans la vue concernee.
#   demo    lampe factice de shared/LampDemo.mc, qui donne au simulateur une
#           lampe a afficher. `bash app/build.sh sim` la garde en passant
#           sim.jungle par-dessus celui-ci.
base.excludeAnnotations = debug;demo

# `shared` contient le protocole et la couche BLE, partagés avec le widget.
# Un chemin de sources commun plutôt qu'un barrel : moins d'outillage, et les
# deux binaires compilent depuis la même vérité.
#
# Les fonctions annotées (:test) ne sont incluses qu'avec --unit-test ;
# source-test peut donc rester dans le chemin en permanence.
base.sourcePath = ../shared;source;source-test

# Les libelles d'interface vivent dans shared/, comme le code : les deux
# binaires doivent afficher exactement les memes mots. Le SDK ajoute deja
# `resources` et `resources-fre` du repertoire du projet ; on y ajoute ceux du
# repertoire partage.
#
# L'anglais est le jeu par defaut, donc le repli pour toute langue non fournie.
# Le francais est une variante — c'est l'inverse de ce qu'on ecrirait
# spontanement, mais un Edge configure en suedois doit tomber sur l'anglais.
base.resourcePath = $(base.resourcePath);../shared/resources
base.lang.fre = $(base.lang.fre);../shared/resources-fre

# Les libelles traduits vivent dans shared/, comme le code : les deux binaires
# doivent afficher exactement les memes mots dans chaque langue. Ces fichiers
# sont GENERES — editer les tables de tools/i18n/, puis :
#   python tools/i18n/generate.py
base.lang.deu = $(base.lang.deu);../shared/resources-deu
base.lang.spa = $(base.lang.spa);../shared/resources-spa
base.lang.ita = $(base.lang.ita);../shared/resources-ita
base.lang.por = $(base.lang.por);../shared/resources-por
base.lang.dut = $(base.lang.dut);../shared/resources-dut
base.lang.pol = $(base.lang.pol);../shared/resources-pol
base.lang.rus = $(base.lang.rus);../shared/resources-rus
base.lang.jpn = $(base.lang.jpn);../shared/resources-jpn
base.lang.kor = $(base.lang.kor);../shared/resources-kor
base.lang.zhs = $(base.lang.zhs);../shared/resources-zhs
base.lang.zht = $(base.lang.zht);../shared/resources-zht

# Icone de lanceur : une taille par appareil.
#
# Le compilateur redimensionne en silence une icone unique, sans le moindre
# avertissement, et 70 px ramenes a 32 donnent une image floue sur les modeles
# ou l'ecran est deja petit. Chaque groupe pointe donc sur son propre dossier de
# ressources, ou `LauncherIcon` est dessine a la taille exacte.
#
# `resources/drawables/` n'existe plus : deux definitions du meme identifiant
# entreraient en conflit.
#
# BLOC GENERE : ne pas le modifier a la main.
#   python tools/gen-targets.py --jungle
# Les images, elles, se regenerent avec :
#   python tools/make-icons.py

# 32 x 32 px
gpsmaph1.resourcePath = $(gpsmaph1.resourcePath);resources-icon-32

