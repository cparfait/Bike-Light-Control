<!--
  Chaines propres a l'application compagnon (francais).

  Doit declarer exactement les memes identifiants que ../resources/strings/strings.xml.
-->
<strings>
    <!--
      Nom affiche dans le store, dans Garmin Connect et dans la liste des
      applications du compteur.

      Ni « Edge » ni « iGPSPORT » : depuis 2025, l'equipe du Connect IQ Store
      traite tout usage d'une marque Garmin dans un titre comme une infraction,
      noms de produits compris, et « iGPSPORT » est une marque tierce. La
      compatibilite se dit dans le texte de presentation, pas dans le titre.

      Les deux binaires portent des noms differents : sans cela ils etaient
      indistinguables l'un de l'autre dans le store comme sur le compteur.
    -->
    <string id="AppName">Panneau eclairage velo</string>
    <string id="SetLowBattery">Seuil de batterie faible (%)</string>

    <!-- Menu des reglages, sur le compteur -->
    <string id="MenuTitle">Reglages</string>

    <!-- Automatismes de la lampe : ils vivent dans son firmware -->
    <string id="LampAutomations">Automatismes de la lampe</string>
    <string id="HintNotConnected">Lampe non connectee</string>
    <string id="LampLumenVary">Luminosite selon vitesse</string>
    <string id="HintByLamp">Gere par la lampe</string>
    <string id="LampAutoLight">Capteur de luminosite</string>
    <string id="HintAutoOn">Allumage automatique</string>
    <string id="LampSyncOff">Extinction synchronisee</string>
    <string id="HintFollowsTimer">Suit l'arret du compteur</string>
    <string id="LampAutoStart">Allumage au depart</string>
    <string id="HintOnStart">A la mise en route</string>
    <string id="LampAutoSleep">Veille automatique</string>
    <string id="HintAfterIdle">Apres immobilite</string>
    <string id="SleepDelay">Delai de veille</string>
    <string id="LampAutoLow">Luminosite reduite a l'arret</string>
    <string id="LowDelay">Delai avant reduction</string>
    <string id="AvailableModes">Modes disponibles</string>

    <!-- Reglages propres a l'application -->
    <string id="AppSettings">Reglages de l'application</string>
    <string id="HintSeparate">Distincts du champ de donnees</string>
