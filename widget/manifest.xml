<?xml version="1.0"?>
<!--
  Application compagnon : pilotage manuel de la lampe hors activité, et sur les
  Edge à boutons ou onTap() du data field ne se declenche pas.

  Type « watch-app » dans le manifeste — « watchApp » dans les profils
  d'appareil, les deux orthographes coexistent — et non « widget » : les Edge recents (540, 550, 840, 850,
  1040, 1050, Explore 2, MTB) ne supportent PAS le type widget — ils ont des
  « glances ». Seuls les Edge plus anciens (530, 830, 1030, Explore) supportent
  les widgets. « watchApp » est le seul type commun aux 13 cibles.
  Verifier avec : bash tools/check-app-types.sh
  Liste des produits identique au data field — voir docs/compatibilite-edge.md.
-->
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <iq:application entry="PanelApp" id="596b574563f84202ab48cfe6842400f1" launcherIcon="@Drawables.LauncherIcon"
                    minApiLevel="3.1.0" name="@Strings.AppName" type="watch-app">
        <iq:products>
            <iq:product id="edge530"/>
            <iq:product id="edge540"/>
            <iq:product id="edge550"/>
            <iq:product id="edge830"/>
            <iq:product id="edge840"/>
            <iq:product id="edge850"/>
            <iq:product id="edge1030"/>
            <iq:product id="edge1030plus"/>
            <iq:product id="edge1040"/>
            <iq:product id="edge1050"/>
            <iq:product id="edgeexplore"/>
            <iq:product id="edgeexplore2"/>
            <iq:product id="edgemtb"/>
        </iq:products>
        <iq:permissions>
            <iq:uses-permission id="BluetoothLowEnergy"/>
        </iq:permissions>
        <iq:languages>
        <!--
          Langues declarees. Le SDK associe a chaque reference materielle un
          jeu de polices : les references « ww » portent les langues
          europeennes, les references APAC portent le japonais, le coreen et
          le chinois. Une langue non portee par la reference retombe sur
          l'anglais, c'est le mecanisme prevu par Garmin.

          Verifier avec : python tools/i18n/langues-supportees.py
          Traductions dans tools/i18n/, regenerees par tools/i18n/generate.py.
        -->
            <iq:language>fre</iq:language>
            <iq:language>deu</iq:language>
            <iq:language>spa</iq:language>
            <iq:language>ita</iq:language>
            <iq:language>por</iq:language>
            <iq:language>dut</iq:language>
            <iq:language>pol</iq:language>
            <iq:language>rus</iq:language>
            <iq:language>jpn</iq:language>
            <iq:language>kor</iq:language>
            <iq:language>zhs</iq:language>
            <iq:language>zht</iq:language>
            <iq:language>eng</iq:language>
        </iq:languages>
    </iq:application>
</iq:manifest>
