project.manifest = manifest.xml

# Deux jeux de code hors des binaires de diffusion :
#
#   debug   surcouche de diagnostic de LampPanel. Pour la lire sur l'appareil,
#           remplacer `debug` par `nodebug` ici, et mettre `panel.debug = true`
#           dans la vue concernee.
#   demo    lampe factice de shared/LampDemo.mc, qui donne au simulateur une
#           lampe a afficher. `bash app/build.sh sim` la garde en passant
#           sim.jungle par-dessus celui-ci.
base.excludeAnnotations = debug;demo

# Meme code protocolaire que le data field : une seule verite.
base.sourcePath = ../shared;source

# Les libelles d'interface vivent dans shared/, comme le code : les deux
# binaires doivent afficher exactement les memes mots. Le SDK ajoute deja
# `resources` et `resources-fre` du repertoire du projet ; on y ajoute ceux du
# repertoire partage.
#
# L'anglais est le jeu par defaut, donc le repli pour toute langue non fournie.
# Le francais est une variante — c'est l'inverse de ce qu'on ecrirait
# spontanement, mais un Edge configure en suedois doit tomber sur l'anglais.
base.resourcePath = $(base.resourcePath);../shared/resources
base.lang.fre = $(base.lang.fre);../shared/resources-fre

# Les libelles traduits vivent dans shared/, comme le code : les deux binaires
# doivent afficher exactement les memes mots dans chaque langue. Ces fichiers
# sont GENERES — editer les tables de tools/i18n/, puis :
#   python tools/i18n/generate.py
base.lang.deu = $(base.lang.deu);../shared/resources-deu
base.lang.spa = $(base.lang.spa);../shared/resources-spa
base.lang.ita = $(base.lang.ita);../shared/resources-ita
base.lang.por = $(base.lang.por);../shared/resources-por
base.lang.dut = $(base.lang.dut);../shared/resources-dut
base.lang.pol = $(base.lang.pol);../shared/resources-pol
base.lang.rus = $(base.lang.rus);../shared/resources-rus
base.lang.jpn = $(base.lang.jpn);../shared/resources-jpn
base.lang.kor = $(base.lang.kor);../shared/resources-kor
base.lang.zhs = $(base.lang.zhs);../shared/resources-zhs
base.lang.zht = $(base.lang.zht);../shared/resources-zht

# Encre de la vignette de resume, une variante par appareil.
#
# Le fond de tuile du systeme n'a pas la meme clarte d'un Edge a l'autre, et
# **rien a l'execution ne dit laquelle on a sous les yeux** : `getGlanceTheme()`
# sert a declarer un theme, pas a lire la couleur qui en decoule. La reponse est
# en revanche dans les profils du SDK, et verifiable a l'ecran — c'est fait, sur
# les huit modeles qui ont une vignette :
#
#   fond sombre : 540, 550, 840, 850, 1040, 1050 (bleu nuit), Explore 2
#   fond clair  : Edge MTB, et lui seul
#
# On choisit donc a la compilation, comme pour la taille de l'icone de lanceur.
# Les modeles sans vignette (530, 830, 1030, 1030 Plus, Explore) prennent la
# variante sombre : le module doit exister pour que le binaire compile, son
# contenu ne sera jamais dessine.
#
# L'alternative essayee, et abandonnee : peindre notre propre fond opaque sous
# le texte. Elle reglait le cas du MTB, mais **recouvrait le theme** sur tous
# les autres — sur un Edge 1050, une boite grise posee au milieu de la tuile
# bleu nuit du systeme.
edge530.sourcePath = $(edge530.sourcePath);source-glance-dark
edge540.sourcePath = $(edge540.sourcePath);source-glance-dark
edge550.sourcePath = $(edge550.sourcePath);source-glance-dark
edge830.sourcePath = $(edge830.sourcePath);source-glance-dark
edge840.sourcePath = $(edge840.sourcePath);source-glance-dark
edge850.sourcePath = $(edge850.sourcePath);source-glance-dark
edge1030.sourcePath = $(edge1030.sourcePath);source-glance-dark
edge1030plus.sourcePath = $(edge1030plus.sourcePath);source-glance-dark
edge1040.sourcePath = $(edge1040.sourcePath);source-glance-dark
edge1050.sourcePath = $(edge1050.sourcePath);source-glance-dark
edgeexplore.sourcePath = $(edgeexplore.sourcePath);source-glance-dark
edgeexplore2.sourcePath = $(edgeexplore2.sourcePath);source-glance-dark
edgemtb.sourcePath = $(edgemtb.sourcePath);source-glance-light

# Icone de lanceur : une taille par appareil.
#
# Le compilateur redimensionne en silence une icone unique, sans le moindre
# avertissement, et 68 px ramenes a 35 donnent une image floue sur les modeles
# ou l'ecran est deja petit. Chaque groupe pointe donc sur son propre dossier de
# ressources, ou `LauncherIcon` est dessine a la taille exacte.
#
# `resources/drawables/` n'existe plus : deux definitions du meme identifiant
# entreraient en conflit. Regenerer les images avec :
#   python tools/make-icons.py

# 35 x 35 px
edge530.resourcePath = $(edge530.resourcePath);resources-icon-35
edge540.resourcePath = $(edge540.resourcePath);resources-icon-35
edge830.resourcePath = $(edge830.resourcePath);resources-icon-35
edge840.resourcePath = $(edge840.resourcePath);resources-icon-35

# 36 x 36 px
edge1030.resourcePath = $(edge1030.resourcePath);resources-icon-36
edge1030plus.resourcePath = $(edge1030plus.resourcePath);resources-icon-36
edgeexplore.resourcePath = $(edgeexplore.resourcePath);resources-icon-36
edgeexplore2.resourcePath = $(edgeexplore2.resourcePath);resources-icon-36
edgemtb.resourcePath = $(edgemtb.resourcePath);resources-icon-36

# 40 x 40 px
edge1040.resourcePath = $(edge1040.resourcePath);resources-icon-40

# 56 x 56 px
edge550.resourcePath = $(edge550.resourcePath);resources-icon-56
edge850.resourcePath = $(edge850.resourcePath);resources-icon-56

# 68 x 68 px
edge1050.resourcePath = $(edge1050.resourcePath);resources-icon-68
